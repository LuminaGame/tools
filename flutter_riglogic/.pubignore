# pub reads this file instead of .gitignore in this folder; keep the two in
# sync. Everything the native-assets hook compiles (src/, third_party/) ships.
.dart_tool/
build/
**/build/
pubspec.lock
pubspec_overrides.yaml

# Native build outputs (tool/build_openriglogic.* and local builds)
*.so
*.o
*.a
*.dylib
*.dll
*.lib
*.obj
*.pdb
*.exp
third_party/openriglogic/build/
third_party/openriglogic/build-*/
third_party/openriglogic/lib/

# dart doc output
doc/api/
